# คัดลอกเป็น terraform.tfvars แล้วแก้ค่า (ไฟล์ terraform.tfvars ถูก .gitignore ไว้แล้ว)
project_name        = "ecommerce-mini-api"
region              = "us-east-1"      # บัญชีส่วนตัวเปลี่ยนเป็น ap-southeast-1 ได้
instance_type       = "t3.micro"
root_volume_size    = 20
ssh_public_key_path = "~/.ssh/ecommerce_deploy.pub"

