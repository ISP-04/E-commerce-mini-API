# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
NODE_ENV=development
PORT=8080

DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
 
# JWT (WS6) — สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
 
# Rate limit (WS10)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
# จำนวน Reverse proxy ด้านหน้า (0 = เปิดตรง) ตั้ง 1 เมื่อวาง Nginx/Load balancer ไว้หน้า API
TRUST_PROXY_HOPS=0
 
# บัญชี Admin ที่สร้างตอน npm run db:seed
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=

REDIS_URL=redis://localhost:6379
CACHE_TTL_PRODUCT=60
CACHE_TTL_PRODUCT_LIST=30

RABBITMQ_URL=amqp://guest:guest@localhost:5672
ORDER_QUEUE=order_events
EMAIL_DELAY_MS=3000
LOW_STOCK_THRESHOLD=5

